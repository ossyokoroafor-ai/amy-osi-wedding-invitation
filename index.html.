<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#541b2d">

<title>Amy & Osi | Wedding Celebration</title>

<meta name="description" content="Join Amy and Osi as they celebrate their wedding on January 2, 2027.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
:root {
  --wine: #541b2d;
  --wine-dark: #35111e;
  --cream: #f8f3eb;
  --champagne: #d9c29c;
  --text: #49313a;
  --muted: #8a747b;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--cream);
  color: var(--text);
  font-family: 'Montserrat', sans-serif;
  font-weight: 300;
}

button, a {
  -webkit-tap-highlight-color: transparent;
}

.cover {
  min-height: 100vh;
  min-height: 100svh;
  background:
    radial-gradient(ellipse at center, rgba(255,255,255,.05), transparent 65%),
    var(--wine-dark);
  color: var(--cream);
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 30px 20px;
  position: relative;
}

.cover::before {
  content: "";
  position: absolute;
  inset: 17px;
  border: 1px solid rgba(217,194,156,.5);
  pointer-events: none;
}

.cover-inner {
  max-width: 550px;
  animation: fadeIn 1.5s ease;
}

.eyebrow {
  font-size: 10px;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: var(--champagne);
  line-height: 2;
}

.cover h1 {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 400;
  font-size: clamp(65px, 15vw, 105px);
  line-height: 1.05;
  margin: 30px 0 20px;
}

.cover h1 span {
  font-style: italic;
  color: var(--champagne);
}

.cover-subtitle {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px;
  font-style: italic;
  color: #eadfce;
  line-height: 1.5;
}

.open-btn {
  background: transparent;
  border: 1px solid var(--champagne);
  color: var(--cream);
  padding: 16px 34px;
  margin-top: 45px;
  letter-spacing: 3px;
  font-family: 'Montserrat', sans-serif;
  font-size: 10px;
  cursor: pointer;
  transition: .3s;
}

.open-btn:hover {
  background: var(--champagne);
  color: var(--wine-dark);
}

.cover-date {
  margin-top: 45px;
  font-size: 10px;
  letter-spacing: 4px;
  color: var(--champagne);
}

#invitation {
  display: none;
}

#invitation.show {
  display: block;
  animation: fadeIn 1s ease;
}

.section {
  padding: 85px 22px;
  text-align: center;
}

.section-inner {
  max-width: 720px;
  margin: auto;
}

.section-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 4px;
  color: #977a65;
  margin-bottom: 20px;
}

.section h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(38px, 8vw, 55px);
  font-weight: 400;
  color: var(--wine);
  margin-bottom: 22px;
}

.section p {
  font-size: 13px;
  line-height: 2;
}

.intro {
  padding-top: 100px;
  padding-bottom: 100px;
}

.intro .names {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(55px, 12vw, 85px);
  font-style: italic;
  color: var(--wine);
  margin: 25px 0;
  font-weight: 400;
}

.ampersand {
  color: #b99c78;
  font-size: 35px;
  display: block;
  margin: 5px;
}

.divider {
  width: 55px;
  height: 1px;
  background: var(--champagne);
  margin: 30px auto;
}

.date-display {
  font-family: 'Cormorant Garamond', serif;
  color: var(--wine);
  font-size: 29px;
  margin-top: 25px;
}

.countdown-section {
  background: var(--wine);
  color: var(--cream);
}

.countdown-section h2 {
  color: var(--cream);
}

.countdown-section .section-label {
  color: var(--champagne);
}

.countdown {
  display: flex;
  justify-content: center;
  gap: clamp(12px, 5vw, 35px);
  margin-top: 35px;
  flex-wrap: wrap;
}

.countdown-item {
  min-width: 55px;
}

.countdown-item strong {
  font-family: 'Cormorant Garamond', serif;
  font-size: 42px;
  font-weight: 400;
  display: block;
  color: var(--champagne);
}

.countdown-item span {
  font-size: 9px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.soft-section {
  background: #f1e9de;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin-top: 35px;
}

.detail-card {
  border: 1px solid #dfd0bc;
  padding: 30px 12px;
  background: rgba(255,255,255,.25);
}

.detail-card h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 27px;
  font-weight: 400;
  color: var(--wine);
  margin-bottom: 12px;
}

.detail-card p {
  font-size: 11px;
}

.events {
  margin-top: 35px;
  text-align: left;
}

.event {
  display: flex;
  gap: 20px;
  padding: 20px 5px;
  border-bottom: 1px solid #e2d6c8;
}

.event-time {
  min-width: 90px;
  font-size: 11px;
  color: #9b785f;
  padding-top: 5px;
}

.event-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 25px;
  color: var(--wine);
}

.event-description {
  font-size: 11px;
  color: var(--muted);
  margin-top: 4px;
}

.dress-box {
  max-width: 480px;
  margin: 30px auto 0;
  border: 1px solid #d9c29c;
  padding: 30px 20px;
}

.dress-box h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 30px;
  font-weight: 400;
  margin-bottom: 10px;
  color: var(--wine);
}

.gallery-placeholder {
  border: 1px dashed #c9b79e;
  padding: 45px 15px;
  margin-top: 30px;
  color: #9b8774;
  font-size: 12px;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-top: 25px;
}

.gallery img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.gallery img:first-child {
  grid-column: span 2;
  aspect-ratio: 16 / 9;
}

.action-btn {
  display: inline-block;
  text-decoration: none;
  background: var(--wine);
  color: var(--cream);
  padding: 16px 28px;
  font-size: 10px;
  letter-spacing: 2px;
  margin-top: 28px;
  transition: .3s;
}

.action-btn:hover {
  background: var(--wine-dark);
}

footer {
  background: var(--wine-dark);
  color: var(--cream);
  padding: 65px 20px;
  text-align: center;
}

footer h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 55px;
  font-weight: 400;
  font-style: italic;
  margin: 15px 0;
}

footer p {
  font-size: 10px;
  letter-spacing: 3px;
  color: var(--champagne);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 480px) {
  .section {
    padding: 70px 20px;
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }

  .cover::before {
    inset: 12px;
  }
}
</style>
</head>

<body>

<!-- OPENING INVITATION -->

<section class="cover" id="cover">
  <div class="cover-inner">
    <p class="eyebrow">Together with our families</p>

    <h1>Amy <span>&</span> Osi</h1>

    <p class="cover-subtitle">
      Two hearts, one promise,<br>
      a beautiful beginning.
    </p>

    <button class="open-btn" onclick="openInvitation()">
      OPEN INVITATION
    </button>

    <p class="cover-date">02 · JANUARY · 2027</p>
  </div>
</section>

<!-- MAIN INVITATION -->

<main id="invitation">

  <section class="section intro">
    <div class="section-inner">
      <p class="section-label">You are cordially invited</p>

      <h1 class="names">
        Amy
        <span class="ampersand">&</span>
        Osi
