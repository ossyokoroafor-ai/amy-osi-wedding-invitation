</main>

<script>

// OPEN THE INVITATION

function openInvitation() {
  document.getElementById("cover").style.display = "none";

  const invitation = document.getElementById("invitation");
  invitation.classList.add("show");

  window.scrollTo({ top: 0, behavior: "smooth" });
}

// WEDDING COUNTDOWN
// Currently counts down to midnight at the start of January 2, 2027,
// in Nigerian time (WAT).

const weddingDate = new Date(
  "2027-01-02T00:00:00+01:00"
).getTime();

function updateCountdown() {
  const now = Date.now();
  const distance = weddingDate - now;

  if (distance <= 0) {
    document.getElementById("countdown").innerHTML =
      "<p>Today is our special day! ❤️</p>";
    return;
  }

  const days = Math.floor(distance / 86400000);
  const hours = Math.floor((distance % 86400000) / 3600000);
  const minutes = Math.floor((distance % 3600000) / 60000);
  const seconds = Math.floor((distance % 60000) / 1000);

  document.getElementById("days").textContent = days;
  document.getElementById("hours").textContent =
    String(hours).padStart(2, "0");
  document.getElementById("minutes").textContent =
    String(minutes).padStart(2, "0");
  document.getElementById("seconds").textContent =
    String(seconds).padStart(2, "0");
}

updateCountdown();
setInterval(updateCountdown, 1000);

// RSVP THROUGH WHATSAPP
// Replace the number below with your WhatsApp number.
// Use country code, without + or spaces.

const RSVP_WHATSAPP = "234XXXXXXXXXX";

function sendRSVP(event) {
  event.preventDefault();

  if (RSVP_WHATSAPP.includes("X")) {
    alert("The wedding RSVP WhatsApp number has not been added yet.");
    return;
  }

  const message =
    "Hello Amy & Osi! I would love to confirm my attendance at your wedding on January 2, 2027.";

  const url =
    "https://wa.me/" + RSVP_WHATSAPP +
    "?text=" + encodeURIComponent(message);

  window.open(url, "_blank");
}

</script>

</body>
</html>
